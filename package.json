{
  "name": "system1-measure",
  "version": "0.1.0",
  "type": "module",
  "description": "The measurement: the question sets, the composition, the chain, the session-log format, the normalized rows and the rules they obey. No harness, no dependencies.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./rules": "./rules/index.js",
    "./core/*": "./core/*",
    "./instrument/*": "./instrument/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "system1-ask": "./bin/ask.mjs"
  },
  "files": [
    "index.js",
    "core/**/*.js",
    "core/README.md",
    "instrument/**/*.js",
    "rules/index.js",
    "rules/fixture/**",
    "criteria/**",
    "!criteria/_parked/**",
    "!criteria/_templates/**",
    "bin/*.mjs",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "prepublishOnly": "npm run ci",
    "test": "node --test test/*.test.js",
    "coverage": "node --experimental-test-coverage --test --test-coverage-include='core/*.js' --test-coverage-include='core/model/*.js' --test-coverage-include='instrument/*.js' --test-coverage-include='rules/*.js' --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=75 test/*.test.js",
    "check:contract-teeth": "node scripts/check-contract-teeth.mjs",
    "check:channel-agreement": "node scripts/check-channel-agreement.mjs",
    "ci": "npm test && npm run coverage && npm run check:contract-teeth",
    "ask": "node bin/ask.mjs"
  },
  "dependencies": {},
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlam1968/system1-measure.git"
  },
  "bugs": {
    "url": "https://github.com/johnlam1968/system1-measure/issues"
  },
  "homepage": "https://github.com/johnlam1968/system1-measure#readme",
  "keywords": [
    "system-one",
    "measurement",
    "session-log",
    "normalized-rows",
    "harness-free"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
